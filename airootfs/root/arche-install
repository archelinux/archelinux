#!/usr/bin/env bash
set -euo pipefail
CHROOT=/mnt
ROOT_OPTIONS=rw,noatime,nodiratime,logbufs=8,logbsize=256k,allocsize=64M

fail() { echo "arche-install: $*" >&2; exit 1; }
ask() { read -r -p "$2" "$1"; }
valid_locale() {
  awk -v locale="$LOCALE" '
    { sub(/^[[:space:]]*#[[:space:]]*/, ""); if ($1 == locale && $2 == "UTF-8") found=1 }
    END { exit !found }
  ' "${1:-/etc/locale.gen}"
}
validate_partition() {
  [[ -b $1 && $(lsblk -dnro TYPE "$1") == part ]] || fail "Not a partition: $1"
  [[ $(lsblk -dnro PKNAME "$1") == "$(basename "$DISK")" ]] || fail "$1 is not on $DISK"
  ! findmnt -rn -S "$1" >/dev/null || fail "$1 is mounted; unmount it first"
  ! swapon --noheadings --raw --show=NAME | grep -Fxq "$1" || fail "$1 is active swap"
}
format_partitions() {
  mkfs.xfs -f -m reflink=1,crc=1 -i size=512 -d agcount=16 "$ROOT_PARTITION"
  if [[ -n $EFI_PARTITION ]]; then mkfs.fat -F32 "$EFI_PARTITION"; fi
}
write_fstab() {
  genfstab -U "$CHROOT" | awk '$2 != "/"' > "$CHROOT/etc/fstab"
  printf 'UUID=%s  /  xfs  %s  0  0\n' "$(blkid -s UUID -o value "$ROOT_PARTITION")" "$ROOT_OPTIONS" >> "$CHROOT/etc/fstab"
}
setup_bootloader() {
  local uuid kernel
  uuid=$(blkid -s UUID -o value "$ROOT_PARTITION")
  if [[ -n $EFI_PARTITION ]]; then
    mountpoint -q "$CHROOT/boot" || fail 'ESP must be mounted at /boot'
    for kernel in zen lts; do
      [[ -s $CHROOT/boot/vmlinuz-linux-$kernel && -s $CHROOT/boot/initramfs-linux-$kernel.img ]] || fail "Missing $kernel kernel/initramfs on ESP"
    done
    # Paths passed inside arch-chroot are relative to the installed system.
    arch-chroot "$CHROOT" bootctl --esp-path=/boot install
    mkdir -p "$CHROOT/boot/loader/entries"
    printf 'default arche-zen.conf\ntimeout 2\neditor no\n' > "$CHROOT/boot/loader/loader.conf"
    for kernel in zen lts; do
      cat > "$CHROOT/boot/loader/entries/arche-$kernel.conf" <<ENTRY
title Arche Linux ($kernel)
linux /vmlinuz-linux-$kernel
initrd /initramfs-linux-$kernel.img
options root=UUID=$uuid rw rootflags=logbufs=8,logbsize=256k,allocsize=64M
ENTRY
    done
  else
    arch-chroot "$CHROOT" pacman -S --needed --noconfirm grub
    arch-chroot "$CHROOT" grub-install --target=i386-pc "$DISK"
    # Explicit entries make Zen the default regardless of grub kernel sorting.
    cat > "$CHROOT/etc/grub.d/09_arche" <<GRUB
#!/bin/sh
cat <<'ENTRIES'
menuentry 'Arche Linux (Zen)' {
  insmod xfs
  search --no-floppy --fs-uuid --set=root $uuid
  linux /boot/vmlinuz-linux-zen root=UUID=$uuid rw rootflags=logbufs=8,logbsize=256k,allocsize=64M
  initrd /boot/initramfs-linux-zen.img
}
menuentry 'Arche Linux (LTS)' {
  insmod xfs
  search --no-floppy --fs-uuid --set=root $uuid
  linux /boot/vmlinuz-linux-lts root=UUID=$uuid rw rootflags=logbufs=8,logbsize=256k,allocsize=64M
  initrd /boot/initramfs-linux-lts.img
}
ENTRIES
GRUB
    chmod 755 "$CHROOT/etc/grub.d/09_arche"
    printf '\nGRUB_DEFAULT=0\nGRUB_TIMEOUT=2\nGRUB_TIMEOUT_STYLE=menu\n' >> "$CHROOT/etc/default/grub"
    arch-chroot "$CHROOT" grub-mkconfig -o /boot/grub/grub.cfg
  fi
}
parse_options() {
  UNATTENDED=false
  LOCKED_ACCOUNTS=false
  DISK='' HOST_NAME=archelinux NORMAL_USER='' LOCALE=en_US.UTF-8 ERASE_DISK=''
  while (( $# )); do
    case $1 in
      --unattended) UNATTENDED=true; shift ;;
      --locked-accounts) LOCKED_ACCOUNTS=true; shift ;;
      --disk|--hostname|--username|--locale|--erase-disk)
        (( $# >= 2 )) || fail "Missing value for $1"
        case $1 in
          --disk) DISK=$2 ;;
          --hostname) HOST_NAME=$2 ;;
          --username) NORMAL_USER=$2 ;;
          --locale) LOCALE=$2 ;;
          --erase-disk) ERASE_DISK=$2 ;;
        esac
        shift 2 ;;
      *) fail "Unknown option: $1" ;;
    esac
  done
  if [[ $UNATTENDED == true ]]; then
    [[ $LOCKED_ACCOUNTS == true ]] || fail 'Unattended mode requires --locked-accounts'
    [[ -n $DISK && $ERASE_DISK == "$DISK" ]] || fail 'Repeat the disk path with --erase-disk'
    [[ -n $NORMAL_USER ]] || fail '--username is required'
    [[ -d /sys/firmware/efi ]] || fail 'Unattended mode currently requires UEFI'
    [[ $HOST_NAME =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || fail 'Invalid hostname'
    [[ $NORMAL_USER =~ ^[a-z_][a-z0-9_-]*$ && $NORMAL_USER != root ]] || fail 'Invalid username'
    valid_locale || fail 'Invalid locale'
  fi
}
partition_unattended() {
  local device
  while read -r device; do
    ! findmnt -rn -S "$device" >/dev/null || fail "$device is mounted"
    ! swapon --noheadings --raw --show=NAME | grep -Fxq "$device" || fail "$device is swap"
  done < <(lsblk -nrpo NAME "$DISK")
  (( $(blockdev --getsize64 "$DISK") >= 19327352832 )) || fail 'Disk needs at least 18 GiB'
  printf 'label: gpt\nsize=1GiB,type=U\ntype=L\n' | sfdisk --wipe always "$DISK"
  udevadm settle
  EFI_PARTITION=$(lsblk -nrpo NAME,PARTN "$DISK" | awk '$2 == 1 {print $1}')
  ROOT_PARTITION=$(lsblk -nrpo NAME,PARTN "$DISK" | awk '$2 == 2 {print $1}')
}
main() {
  parse_options "$@"
  (( EUID == 0 )) || fail 'Run as root from the Arche live ISO.'
  [[ -f /usr/share/arche/repo/arche.db ]] || fail 'Missing bundled package repository; run scripts/build-repo.sh before building the ISO.'
  for repository in core extra; do
    [[ -n $(pacman-conf --repo "$repository" Server) ]] || fail "No servers configured for $repository; enable a mirror before installing."
  done
  # pacstrap verifies its initial transaction using the live host's keyring.
  # mkarchiso removes build-host key material; initialize fresh live trust.
  pacman-key --init
  pacman-key --populate archlinux
  echo 'Arche Linux: XFS, Zen + LTS, ZRAM, terminal and agent tools.'
  lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
  if [[ $UNATTENDED == false ]]; then ask DISK 'Target disk (absolute /dev/ path): '; fi
  [[ -b $DISK && $(lsblk -dnro TYPE "$DISK") == disk ]] || fail 'Invalid disk'
  EFI_PARTITION=
  if [[ $UNATTENDED == true ]]; then
    partition_unattended
  else
    echo 'Create a root partition (at least 16 GiB). UEFI: add a 1 GiB EFI system partition.'
    echo 'BIOS with GPT: also create a 1 MiB BIOS boot partition.'
    cfdisk "$DISK"
    udevadm settle
    ask ROOT_PARTITION 'Root partition (absolute /dev/ path, WILL BE ERASED): '
    if [[ -d /sys/firmware/efi ]]; then
      ask EFI_PARTITION 'EFI system partition (absolute /dev/ path, WILL BE ERASED): '
    fi
  fi
  validate_partition "$ROOT_PARTITION"
  (( $(blockdev --getsize64 "$ROOT_PARTITION") >= 17179869184 )) || fail 'Root needs at least 16 GiB'
  if [[ -n $EFI_PARTITION ]]; then
    validate_partition "$EFI_PARTITION"
    [[ $(readlink -f "$EFI_PARTITION") != "$(readlink -f "$ROOT_PARTITION")" ]] || fail 'Root and EFI must differ'
    (( $(blockdev --getsize64 "$EFI_PARTITION") >= 1073741824 )) || fail 'EFI partition needs at least 1 GiB for both kernels'
  fi
  if [[ $UNATTENDED == false ]]; then ask HOST_NAME 'Hostname: '; fi
  [[ $HOST_NAME =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || fail 'Invalid hostname'
  if [[ $UNATTENDED == false ]]; then ask NORMAL_USER 'Username: '; fi
  [[ $NORMAL_USER =~ ^[a-z_][a-z0-9_-]*$ && $NORMAL_USER != root ]] || fail 'Invalid username'
  if [[ $UNATTENDED == false ]]; then ask LOCALE 'Locale [en_US.UTF-8]: '; fi
  LOCALE=${LOCALE:-en_US.UTF-8}
  valid_locale || fail 'Choose a UTF-8 locale from /etc/locale.gen'
  if [[ $UNATTENDED == false ]]; then
    ask CONFIRM "Type ERASE to format $ROOT_PARTITION ${EFI_PARTITION} and install: "
    [[ $CONFIRM == ERASE ]] || fail 'Cancelled'
  fi
  ! mountpoint -q "$CHROOT" || fail "$CHROOT is already mounted"
  format_partitions
  mkdir -p "$CHROOT"
  mount -t xfs -o "$ROOT_OPTIONS" "$ROOT_PARTITION" "$CHROOT"
  if [[ -n $EFI_PARTITION ]]; then
    mkdir -p "$CHROOT/boot"
    mount "$EFI_PARTITION" "$CHROOT/boot"
  fi
  # The local repository is present inside the ISO and usable by pacstrap.
  pacstrap -K "$CHROOT" arche-base arche-tui-stack arche-agentic-core
  write_fstab
  cp -a "$CHROOT/usr/share/arche/skel/." "$CHROOT/etc/skel/"
  mkdir -p "$CHROOT/usr/share/arche/repo"
  cp -a /usr/share/arche/repo/. "$CHROOT/usr/share/arche/repo/"
  cp /etc/pacman.conf "$CHROOT/etc/pacman.conf"
  install -Dm644 /etc/os-release "$CHROOT/etc/os-release"
  printf 'Arche Linux \n' > "$CHROOT/etc/issue"
  printf '%s\n' "$HOST_NAME" > "$CHROOT/etc/hostname"
  printf 'LANG=%s\n' "$LOCALE" > "$CHROOT/etc/locale.conf"
  printf '%s UTF-8\n' "$LOCALE" >> "$CHROOT/etc/locale.gen"
  arch-chroot "$CHROOT" locale-gen
  ln -sf /usr/share/zoneinfo/UTC "$CHROOT/etc/localtime"
  arch-chroot "$CHROOT" hwclock --systohc
  # pacstrap uses normal kernel presets, never the live archiso initramfs config.
  arch-chroot "$CHROOT" mkinitcpio -P
  arch-chroot "$CHROOT" useradd -m -U -k /usr/share/arche/skel -G wheel -s /bin/zsh "$NORMAL_USER"
  if [[ $LOCKED_ACCOUNTS == false ]]; then
    arch-chroot "$CHROOT" passwd "$NORMAL_USER"
    arch-chroot "$CHROOT" passwd root
  else
    arch-chroot "$CHROOT" passwd -l "$NORMAL_USER"
    arch-chroot "$CHROOT" passwd -l root
  fi
  install -d -m750 "$CHROOT/etc/sudoers.d"
  printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$CHROOT/etc/sudoers.d/10-wheel"
  chmod 440 "$CHROOT/etc/sudoers.d/10-wheel"
  arch-chroot "$CHROOT" systemctl enable NetworkManager.service paccache.timer
  setup_bootloader
  echo 'Installation complete. Unmount /mnt recursively and reboot; inference services are opt-in.'
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
