# Maintainer: Arche Linux maintainers
pkgbase=arche-base
pkgname=(arche-base arche-maintenance)
pkgver=2.0.0
pkgrel=3
pkgdesc='Base system, tuned XFS and dual kernels'
arch=('any')
url='https://github.com/archelinux/archelinux'
license=('GPL-3.0-only')
_full_deps=('base' 'base-devel' 'xfsprogs' 'zram-generator' 'pacman-contrib' 'git' 'curl' 'wget' 'polkit' 'openssh' 'linux-zen' 'linux-zen-headers' 'linux-lts' 'linux-lts-headers' 'linux-firmware' 'networkmanager' 'systemd' 'mkinitcpio' 'dosfstools' 'sudo' 'intel-ucode' 'amd-ucode')

makedepends=("${_full_deps[@]}")
source=('config-0' 'config-1' 'config-2' 'config-3' 'config-4' 'enable-rolling' 'release-key.asc')
sha256sums=('da73450ac9f472caaea7c2d051085b6919ed352abebdad3a9fb18fd8ed714506' '70cd6669944b275679c2d18a08191125dbbcb236a50ef30cfa1dd0a4ab28fe62' 'b6711f260e4aa5efa3e2612196d179ad862141c1074b2d9acf0a2975ff5137ad' 'cd677dd10f7f407742c72bef1a0edb941dcb0a6bf9846d3121f65a638c575c4e' '8870e770b217595ce855903045047ed9c1960269182c3466b9a467b3152d857a' '8c3c0bfad39ee99f3ba92c49f086d4774b55d2b6603672b32ce7067b836a5a31' 'b08194ff73aee8b15f8bd57950c8547e8266a5c7318fe40280c3f8804d9483fe')
backup=('etc/systemd/system/paccache.service.d/keep-three.conf' 'etc/pacman.d/hooks/99-arche-paccache.hook')
package_arche-maintenance() {
  pkgdesc='Arche package cache retention and rollback'
  depends=('pacman-contrib' 'python')
  install -Dm755 "$srcdir/enable-rolling" "$pkgdir/usr/bin/arche-enable-rolling"
  install -Dm644 "$srcdir/release-key.asc" "$pkgdir/usr/share/arche/archelinux-release.asc"
  provides=('paccache-hook')
  conflicts=('paccache-hook')
  install -Dm644 "$srcdir/config-2" "$pkgdir/etc/systemd/system/paccache.service.d/keep-three.conf"
  install -Dm644 "$srcdir/config-3" "$pkgdir/etc/pacman.d/hooks/99-arche-paccache.hook"
  install -Dm755 "$srcdir/config-4" "$pkgdir/usr/bin/arche-rollback"
}

package_arche-base() {
  depends=("arche-maintenance" "${_full_deps[@]}")
  backup=(etc/systemd/zram-generator.conf etc/sysctl.d/99-arche-perf.conf)
  install -Dm644 "$srcdir/config-0" "$pkgdir/etc/systemd/zram-generator.conf"
  install -Dm644 "$srcdir/config-1" "$pkgdir/etc/sysctl.d/99-arche-perf.conf"
}
