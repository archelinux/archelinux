build() {
  # Use the toolchain flags supplied by makepkg.
  # shellcheck disable=SC2086
  cc $CFLAGS $CPPFLAGS $LDFLAGS -fPIC -shared -I "$srcdir/tree-sitter-go-0.25.0/src" \
    -o "$srcdir/go.so" "$srcdir/tree-sitter-go-0.25.0/src/parser.c"
  # shellcheck disable=SC2086
  cc $CFLAGS $CPPFLAGS $LDFLAGS -o "$srcdir/arche-mtp" "$srcdir/arche-mtp.c" -lmtp
  for shell in bash zsh; do
    {
      echo 'if command -v zoxide >/dev/null; then'
      zoxide init --cmd cd "$shell"
      echo 'fi'
      echo 'if command -v direnv >/dev/null; then'
      direnv hook "$shell"
      echo 'fi'
    } > "$srcdir/$shell.hooks"
  done
}
package_arche-workspace-defaults() {
  pkgdesc='Arche workspace templates, shell hooks and desktop artwork'
  license=('GPL-3.0-only' 'MIT')
  optdepends=('python: Waybar status indicators' 'iproute2: WireGuard interface detection' 'wiremix: PipeWire mixer' 'bluez-utils: Bluetooth control' 'yazi: Terminal file manager' 'udisks2: Removable drive actions in Yazi')
  depends=('glibc' 'less' 'gsettings-desktop-schemas' 'libmtp')

  install -Dm755 "$srcdir/arche-mtp" "$pkgdir/usr/bin/arche-mtp"
  install -Dm644 "$srcdir/90_arche-dark.gschema.override" "$pkgdir/usr/share/glib-2.0/schemas/90_arche-dark.gschema.override"
  local mount_plugin="$srcdir/plugins-${_yazi_plugins_commit}/mount.yazi"
  install -Dm644 "$mount_plugin/LICENSE" "$pkgdir/usr/share/licenses/arche-workspace-defaults/mount.yazi"
  install -Dm644 "$srcdir/yazi-keymap.toml" "$pkgdir/usr/share/arche/skel/.config/yazi/keymap.toml"
  install -Dm644 "$srcdir/yazi-theme.toml" "$pkgdir/usr/share/arche/skel/.config/yazi/theme.toml"
  install -Dm644 -t "$pkgdir/usr/share/arche/skel/.config/yazi/plugins/mount.yazi" "$mount_plugin/"*.lua
  install -Dm644 "$srcdir/first-session.md" "$pkgdir/usr/share/doc/arche-workspace-defaults/first-session.md"
  install -Dm644 "$srcdir/arche-first-session.desktop" "$pkgdir/usr/share/applications/arche-first-session.desktop"
  install -Dm755 "$srcdir/waybar-status" "$pkgdir/usr/lib/arche/waybar-status"
  install -Dm644 "$srcdir/arche-logo.svg" "$pkgdir/usr/share/arche/logo.svg"
  install -Dm644 "$srcdir/foot.ini" "$pkgdir/usr/share/arche/skel/.config/foot/foot.ini"
  install -Dm644 "$srcdir/twin-blades.jpg" "$pkgdir/usr/share/arche/twin-blades.jpg"
  install -Dm644 "$srcdir/desktop-11" "$pkgdir/usr/share/doc/arche-tui-stack/UPSTREAM"
  install -Dm644 "$srcdir/desktop-10" "$pkgdir/usr/share/doc/arche-tui-stack/LICENSE.okubax"
  install -Dm644 "$srcdir/desktop-9" "$pkgdir/usr/share/arche/start-sway.sh"
  install -Dm644 "$srcdir/desktop-8" "$pkgdir/usr/share/arche/skel/.zprofile"
  install -Dm644 "$srcdir/desktop-7" "$pkgdir/usr/share/arche/skel/.config/waybar/style.css"
  install -Dm644 "$srcdir/desktop-6" "$pkgdir/usr/share/arche/skel/.config/waybar/litho-dark.css"
  install -Dm644 "$srcdir/desktop-5" "$pkgdir/usr/share/arche/skel/.config/waybar/config.jsonc"
  install -Dm644 "$srcdir/desktop-4" "$pkgdir/usr/share/arche/skel/.config/sway/config"
  install -Dm644 "$srcdir/desktop-3" "$pkgdir/usr/share/arche/skel/.config/mako/config"
  install -Dm644 "$srcdir/desktop-2" "$pkgdir/usr/share/arche/skel/.config/fuzzel/fuzzel.ini"
  install -Dm644 "$srcdir/desktop-0" "$pkgdir/usr/share/arche/skel/.bash_profile"
  install -Dm644 "$srcdir/config-0" "$pkgdir/etc/tmux.conf"
  install -Dm644 "$srcdir/config-1" "$pkgdir/usr/share/arche/skel/.bashrc"
  install -Dm644 "$srcdir/config-2" "$pkgdir/usr/share/arche/skel/.zshrc"
  install -Dm644 "$srcdir/config-4" "$pkgdir/usr/share/arche/skel/.config/nvim/init.lua"
  install -Dm644 "$srcdir/nvim-workspace.lua" "$pkgdir/usr/share/arche/skel/.config/nvim/lua/plugins/workspace.lua"
  install -Dm644 "$srcdir/nvim-colors.lua" "$pkgdir/usr/share/arche/skel/.config/nvim/lua/plugins/colors.lua"
  install -Dm644 "$srcdir/nvim-archevim.lua" "$pkgdir/usr/share/arche/skel/.config/nvim/colors/archevim.lua"
  install -Dm644 "$srcdir/nvim-archevim-lualine.lua" "$pkgdir/usr/share/arche/skel/.config/nvim/lua/lualine/themes/archevim.lua"
  install -Dm644 "$srcdir/nvim-options.lua" "$pkgdir/usr/share/arche/skel/.config/nvim/lua/config/options.lua"
  install -Dm644 "$srcdir/nvim-keymaps.lua" "$pkgdir/usr/share/arche/skel/.config/nvim/lua/config/keymaps.lua"
  install -Dm644 "$srcdir/nvim-lock.json" "$pkgdir/usr/share/arche/skel/.config/nvim/lazy-lock.json"
  for shell in bash zsh; do
    install -Dm644 "$srcdir/$shell.hooks" "$pkgdir/usr/share/arche/shell/$shell.sh"
  done
  zsh -fc 'zcompile "$1"' -- "$pkgdir/usr/share/arche/shell/zsh.sh"
}

package_arche-neovim-parsers() {
  pkgdesc='Neovim parsers and highlight queries for Go, Python and Rust'
  license=('GPL-3.0-only' 'MIT')
  depends=(tree-sitter-python tree-sitter-rust)
  backup=()
  install -d "$pkgdir/usr/share/nvim/site/parser"
  install -Dm644 "$srcdir/tree-sitter-go-0.25.0/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/tree-sitter-go"
  install -Dm755 "$srcdir/go.so" "$pkgdir/usr/lib/tree_sitter/go.so"
  ln -s /usr/lib/tree_sitter/go.so "$pkgdir/usr/share/nvim/site/parser/go.so"
  install -Dm644 "$srcdir/go-highlights.scm" "$pkgdir/usr/share/nvim/site/queries/go/highlights.scm"
  for lang in python rust; do
    ln -s "/usr/lib/tree_sitter/$lang.so" "$pkgdir/usr/share/nvim/site/parser/$lang.so"
    install -Dm644 "$srcdir/$lang-highlights.scm" "$pkgdir/usr/share/nvim/site/queries/$lang/highlights.scm"
  done
}

package_arche-tui-stack() {
  depends=(arche-neovim-parsers "arche-workspace-defaults" "${_full_deps[@]}")
  backup=()
}

package_arche-waybar-github() {
  pkgdesc='Unread GitHub pull requests and issues for Waybar'
  depends=(github-cli xdg-utils python)
  backup=()
  install -Dm755 "$srcdir/arche-waybar-github" "$pkgdir/usr/bin/arche-waybar-github"
}
