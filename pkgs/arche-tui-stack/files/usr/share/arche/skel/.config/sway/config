# Arche Linux — Litho Dark adaptation, 2026-11-10.
# Upstream design: https://github.com/okubax/dotfiles
# Alt+Return: terminal; Alt+d: launcher; Alt+Shift+e: end session.
set $mod Mod1
set $term foot
set $menu fuzzel
font pango:JetBrainsMono Nerd Font 10
# The first layout defines the physical keys for the workspace shortcuts.
input type:keyboard xkb_layout us,ir
include ~/.config/sway/keyboard.conf
floating_modifier $mod normal
xwayland enable

# Import Arch's session environment integration, then apply Arche defaults.
include /etc/sway/config.d/*
default_border pixel 1
default_floating_border pixel 1
for_window [all] border pixel 1
titlebar_border_thickness 0
titlebar_padding 0 0
gaps inner 9
gaps outer 4
gaps horizontal 8
client.focused #998f9f #202226 #ffffff #998f9f #998f9f
client.focused_inactive #34363a #202226 #c4c7ca #34363a #34363a
client.unfocused #34363a #202226 #c4c7ca #34363a #34363a
client.urgent #000000 #000000 #ffffff #000000 #000000
output * bg /usr/share/arche/twin-blades.jpg fill

exec mako
exec swayidle -w timeout 900 'swaylock -f -c 000000' timeout 905 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f -c 000000'

bindsym Mod4+space input type:keyboard xkb_switch_layout next
bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+d exec $menu
bindsym --to-code $mod+Shift+q kill
bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+e exit
bindsym --to-code $mod+Escape exec swaylock -f -c 000000
bindsym --to-code $mod+h focus left
bindsym --to-code $mod+j focus down
bindsym --to-code $mod+k focus up
bindsym --to-code $mod+l focus right
bindsym --to-code $mod+Shift+h move left
bindsym --to-code $mod+Shift+j move down
bindsym --to-code $mod+Shift+k move up
bindsym --to-code $mod+Shift+l move right
bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv
bindsym --to-code $mod+e layout toggle split
bindsym --to-code $mod+f fullscreen toggle
bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+space focus mode_toggle
bindsym --to-code $mod+Tab workspace back_and_forth
bindsym --to-code $mod+Shift+minus move scratchpad
bindsym --to-code $mod+minus scratchpad show
bindsym --to-code $mod+r mode "resize"
mode "resize" {
    bindsym --to-code h resize shrink width 10px
    bindsym --to-code j resize grow height 10px
    bindsym --to-code k resize shrink height 10px
    bindsym --to-code l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86MonBrightnessUp exec brightnessctl -q set +5%
bindsym XF86MonBrightnessDown exec brightnessctl -q set 5%-
bar {
    position top
    swaybar_command waybar
}
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+Shift+6 move container to workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+Shift+7 move container to workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+Shift+8 move container to workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+Shift+9 move container to workspace number 9
