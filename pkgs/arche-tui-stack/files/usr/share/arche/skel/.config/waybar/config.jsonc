{
  "layer": "top",
  "position": "top",
  "height": 34,
  "modules-center": [
    "clock"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    }
  },
  "sway/mode": {
    "format": "⚙ {}"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5,
    "on-click": "foot -e top",
    "tooltip": false
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
  },
  "wireplumber": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "  offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "interval": 10,
    "tooltip-format-wifi": "{essid} · {ipaddr}/{cidr}"
  },
  "custom/github": {
    "exec-if": "test -x /usr/bin/arche-waybar-github",
    "exec": "/usr/bin/arche-waybar-github",
    "return-type": "json",
    "interval": 120,
    "hide-empty-text": true,
    "on-click": "xdg-open https://github.com/notifications"
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "interval": 1,
    "format": "<span foreground=\"#bdc1c6\">{0:%a %d %b %Y}</span>  ·  {0:%H:%M:%S}",
    "format-alt": "{:%A, %B %d, %Y (%T)}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "margin": "13 13 0 13",
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/window"
  ],
  "modules-right": [
    "privacy",
    "custom/github",
    "custom/gpu",
    "cpu",
    "memory",
    "custom/disk",
    "custom/vpn",
    "network",
    "tray",
    "wireplumber",
    "battery"
  ],
  "sway/window": {
    "max-length": 42,
    "tooltip": false
  },
  "privacy": {
    "icon-size": 16,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      }
    ]
  },
  "custom/disk": {
    "exec": "/usr/lib/arche/waybar-status disk",
    "return-type": "json",
    "interval": 60,
    "hide-empty-text": true
  },
  "custom/gpu": {
    "exec": "/usr/lib/arche/waybar-status gpu",
    "return-type": "json",
    "interval": 10,
    "hide-empty-text": true
  },
  "custom/vpn": {
    "exec": "/usr/lib/arche/waybar-status vpn",
    "return-type": "json",
    "interval": 15,
    "hide-empty-text": true
  }
}
