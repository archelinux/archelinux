[[ -o interactive ]] || return
export ZSH=/usr/share/oh-my-zsh
ZSH_CUSTOM="${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-zsh"
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
zstyle ':omz:update' mode disabled
ZSH_THEME="bureau"
plugins=(git archlinux sudo extract colored-man-pages history-substring-search)
if (( $+commands[fzf] )); then
  plugins+=(fzf fzf-tab)
fi
source "$ZSH/oh-my-zsh.sh"
# Apply Arche navigation hooks after Oh My Zsh initializes the interactive shell.
[[ ! -r /usr/share/arche/skel/.zshrc ]] || source /usr/share/arche/skel/.zshrc
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
