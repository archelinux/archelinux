# Maintainer: archelinux maintainers
pkgname=basedpyright
pkgver=1.40.2
pkgrel=1
pkgdesc='Python type checker and language server'
arch=('any')
url='https://github.com/DetachHead/basedpyright'
license=('MIT')
depends=('nodejs')
conflicts=('basedpyright-bin')
options=('!strip' '!debug')
source=('basedpyright-1.40.2.tgz::https://registry.npmjs.org/basedpyright/-/basedpyright-1.40.2.tgz')
sha256sums=('5d1073a0e61a1adc6b40b2bed4489017aa5c1336aa8e6fdcb7157b9bf26f3fab')

package() {
  local dest="$pkgdir/usr/lib/node_modules/$pkgname"
  install -d "$dest" "$pkgdir/usr/bin"
  cp -a package/. "$dest/"
  chmod 755 "$dest/index.js" "$dest/langserver.index.js"
  ln -s "../lib/node_modules/$pkgname/index.js" "$pkgdir/usr/bin/basedpyright"
  ln -s "../lib/node_modules/$pkgname/langserver.index.js" "$pkgdir/usr/bin/basedpyright-langserver"
  install -Dm644 package/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
